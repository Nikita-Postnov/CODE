{
  "manifest_version": 3,
  "name": "NP Punto Browser",
  "version": "1.1.0",
  "description": "Локальное исправление EN/RU раскладки в веб-полях с защищённой передачей языка Windows",
  "permissions": [
    "storage",
    "nativeMessaging"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "layout_core.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  }
}
