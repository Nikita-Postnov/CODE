{
  "manifest_version": 3,
  "name": "NP Punto Browser",
  "version": "1.0.4",
  "description": "Локальное исправление EN/RU раскладки в обычных текстовых полях Chrome и Edge",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "layout_core.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "options_page": "options.html"
}
